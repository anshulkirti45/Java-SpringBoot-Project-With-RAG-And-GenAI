
@'
# ==============================
# Java / Spring Boot (Backend)
# ==============================

*.class
backend/target/
backend/build/
backend/.gradle/

# IDE files
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Logs
*.log
logs/

# ==============================
# Node.js / Next.js (Frontend)
# ==============================

# Dependencies
client/node_modules/
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
client/dist/
client/build/
client/.next/
client/out/
client/coverage/
.next/
out/
build/
coverage/

# Environment variables and secrets
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example

# Package manager / debug logs
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Deployment
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Other generated files
*.pem
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.swp
*.bak
'@ | Set-Content -Encoding utf8 .gitignore
